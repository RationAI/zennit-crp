# Storage roots — copy to `.env` and set for your deployment.
# These are DECLARED, not detected: the code never probes the filesystem to
# decide what is fast/slow/persistent. See experiments/storage.py.

# Durable storage that survives pod bounces (results, checkpoints, figures,
# web-referenced data, and the persistent mirror of regenerable caches).
# This deployment: the NFS/GPFS workspace.  Default if unset: <repo>/data
ZENNIT_PERSIST_ROOT=/home/claude/workspaces/zennit-crp/data

# Fast, ephemeral scratch — wiped on pod bounce. Expensive caches (e.g. the
# FeatureVisualization index) are BUILT here, then synced to the persistent root.
# This deployment: node-local overlay.  Default if unset: ~/.cache/zennit-crp
ZENNIT_SCRATCH_ROOT=/home/claude/.cache/zennit-crp
